# Copy to .env (default server) or .env.<name> in ~/.ibmi-agent-kit. See the root README,
# Profiles, for the folders searched and how to add more servers.

IBMI_HOST=ibmi.example.com
IBMI_USER=MYUSER
IBMI_PASSWORD=changeme

# optional
IBMI_SQL_TRANSPORT=ssh         # ssh uploads and runs the bundled jar; daemon uses an admin-run Mapepire server
IBMI_SSH_PORT=22               # ssh port on the box (ssh transport; PUB400 uses 2222)
IBMI_MAPEPIRE_PORT=8076        # mapepire server port (daemon transport)
IBMI_SOURCE_FILE_CCSID=37      # ebcdic page to read ccsid 65535 columns as
IBMI_LOCAL_DIR=ibmi-src        # where local copies are written
IBMI_MAPEPIRE_JAR=             # a jar already on the box, instead of the bundled one
IBMI_READ_ONLY=false           # true blocks upload, compile and library list changes
IBMI_BLOCKED_CL=               # extra cl commands compile_member must refuse
IBMI_BLOCKED_TABLES=           # tables run_sql must refuse, list the sql name and the system name
