{
  "name": "@ibmi-agent-kit/screen",
  "version": "0.2.0",
  "description": "MCP server that drives IBM i 5250 green screens, the way Playwright MCP drives web pages",
  "type": "module",
  "bin": {
    "ibmi-agent-kit-screen": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    }
  },
  "files": [
    "dist",
    "screen-tests",
    ".env.example",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18.15"
  },
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc",
    "start": "node dist/index.js",
    "check": "npm run build && node --test --test-reporter=dot dist/selfcheck.js",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ibm-i",
    "as400",
    "iseries",
    "5250",
    "tn5250",
    "green-screen",
    "rpg",
    "dspf",
    "claude"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klintravis/ibmi-agent-kit.git",
    "directory": "packages/screen"
  },
  "homepage": "https://github.com/klintravis/ibmi-agent-kit/tree/main/packages/screen#readme",
  "bugs": {
    "url": "https://github.com/klintravis/ibmi-agent-kit/issues"
  },
  "author": "Klint Travis",
  "contributors": [
    {
      "name": "Saman",
      "url": "https://github.com/SH4RKKK/ibm-i-5250-mcp"
    }
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@ibmi-agent-kit/core": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
