# ibmi-agent-kit profile skeleton for partition qa. Copy it to
# ~/.ibmi-agent-kit/.env.qa and fill in your own user.
IBMI_HOST=kqa01.example.com
IBMI_USER=YOUR_USER
IBMI_SQL_TRANSPORT=ssh
IBMI_PARTITION=qa
IBMI_KIT_POLICY=/path/to/company-config/policy.yaml
# The password is not kept here: add it in your own copy only, never in this repo.
