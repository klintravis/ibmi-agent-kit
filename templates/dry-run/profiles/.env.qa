# ibmi-agent-kit profile skeleton for partition qa. Do not copy it: run setup
# in this repo (README, Get started); it writes your profile with your own user.
IBMI_HOST=kqa01.example.com
IBMI_USER=YOUR_USER
IBMI_SQL_TRANSPORT=ssh
IBMI_PARTITION=qa
# No password or helper here: at setup you choose the OS store or a helper, in your own profile, never in this repo.
